# Licensed odds feed (vendor not chosen yet). JSON shaped like LinesSnapshot
# in src/lib/types.ts. Unset → every route renders its empty state.
LINES_FEED_URL=
LINES_FEED_TOKEN=

# Comma-separated hosts allowed to serve player headshots (licensed feed CDN or
# league-approved host only). Empty → team marks / initials everywhere.
LICENSED_HEADSHOT_HOSTS=

# Canonical URL once a Portal Juice domain is ours. Never ripsportal.com.
NEXT_PUBLIC_SITE_URL=
