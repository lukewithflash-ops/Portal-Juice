# Licensed odds feed (vendor not chosen yet). JSON shaped like LinesSnapshot
# in src/lib/types.ts. Unset → the prop board stays empty.
LINES_FEED_URL=
LINES_FEED_TOKEN=

# Extra hosts allowed to serve player headshots. a.espncdn.com is always allowed.
LICENSED_HEADSHOT_HOSTS=

# Canonical URL. Defaults to https://portaljuice.app when unset.
NEXT_PUBLIC_SITE_URL=
